# Where pg_hub keeps durable cursors and Message-ID/patch/commit dedup state.
PG_HUB_STATE=.pg_hub/state.db
PG_HUB_CACHE=.pg_hub/cache

# Live source polling.
PG_ARCHIVE_BASE_URL=https://www.postgresql.org
PG_MAILING_LIST=pgsql-hackers
PG_MAIL_LOOKBACK_MINUTES=180
PG_MAIL_MAX_MESSAGES=100
COMMITFEST_BASE_URL=https://commitfest.postgresql.org
COMMITFEST_ID=61
POSTGRES_GIT_URL=https://git.postgresql.org/git/postgresql.git
POSTGRES_GIT_BRANCH=master

# Polling intervals for the long-running scheduler.
MAIL_POLL_SECONDS=600
COMMITFEST_POLL_SECONDS=600
GIT_POLL_SECONDS=900

# GitHub target. This must be a user-controlled PostgreSQL fork/mirror.
# The project deliberately refuses postgres/postgres and postgresql/postgresql.
GITHUB_TARGET_REPOSITORY=your-org/pg_hub
GITHUB_BASE_BRANCH=master
GITHUB_API_URL=https://api.github.com

# A short-lived GitHub App installation token is recommended. A PAT is useful
# only for local development because its actions are attributed to its owner.
GITHUB_TOKEN=

# Optional GitHub App exchange. Used only when GITHUB_TOKEN is empty.
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
